[Unit]
Description=WordBook Node.js Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/WordBook
ExecStart=/usr/bin/node /opt/WordBook/backend/server.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3040
EnvironmentFile=-/etc/WordBook.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
